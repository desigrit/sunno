# Python
.venv/
__pycache__/
*.pyc

# Downloaded model weights (fetched at first run, 100s of MB)
models/*.onnx
models/*.tar.bz2
models/sherpa-onnx-*/
models/speakers.json

# Build output
app/bin/
app/obj/
packaging/staging/
packaging/out/
*.msix
*.pfx
*.cer

# Recordings / scratch
testdata/

# Diagnostics and logs, whether this machine's or someone else's.
#
# Sunno's diagnostics export saves wherever the user chooses, so it never lands here by itself.
# The risk runs the other way: a user emails a report, it gets dropped in the repo to read, and
# `git add .` publishes their device names and logs to a public repository. These patterns make
# that impossible rather than merely unlikely.
#
# local/ is the place for anything of that kind. Nothing in it is ever tracked.
local/
*.log
sunno-diagnostics*.txt

# Benchmark working files.
#
# .onnx-models holds ONNX Whisper weights the ARM benchmark downloads - about 1.7 GB for the
# small tiers alone, and rebuildable from HuggingFace at any time.
#
# The other two are outputs of a benchmark run, and both are machine-specific: arm-hardware.json
# records the numbers measured on whichever laptop ran it, and bench-speech.wav is synthesised
# locally by the Windows voice. Their numbers get transcribed into server/hardware.py by hand,
# which is where a measurement becomes something the app ships.
.onnx-models/
bench/arm-hardware.json
bench/bench-speech.wav
bench/.qnn-models/
bench/qnn-whisper-*.json
bench/latency_table.json


# Built CUDA release assets. 477 MB of binaries that are published to a GitHub
# release, never committed; cublasLt alone is 388 MB, past GitHub's 100 MB limit.
packaging/cuda-assets/

# Build-time downloads for ARM64 staging: the embeddable interpreter and the VCLibs
# redistributable that carries msvcp140.dll. Fetched by packaging/stage-backend.ps1 and
# re-fetched if absent, so they are a cache rather than an input.
packaging/cache/
