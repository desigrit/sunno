<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Sunno.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Sunno.Models"
    xmlns:local="using:Sunno"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- title bar (content is extended into it) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="44" Padding="16,0,146,0"
              ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- The whole bar is the drag region again now that no button sits in it. -->
            <!-- The real app icon rather than a generic glyph, so the title bar matches the
                 taskbar and Start tile. Source is set from disk in code: ms-appx:/// goes
                 through the package resource system, which does not index files the packaging
                 script copies in after publish. -->
            <Image x:Name="TitleBarIcon" Grid.Column="0" Width="16" Height="16"
                   VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Sunno"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        </Grid>

        <!-- body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- speakers pane -->
            <Border Grid.Column="0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,1,0">
                <Grid Padding="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Speakers" Margin="16,0,16,8"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <ListView x:Name="SpeakerList" Grid.Row="1"
                              ItemsSource="{x:Bind Speakers}"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              ItemClick="OnSpeakerClicked"
                              Padding="8,0,8,8"
                              AutomationProperties.Name="Speakers. Select one to rename.">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SpeakerRow">
                                <Grid ColumnSpacing="10" Padding="4,7"
                                      AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
                                      ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="10" Height="10"
                                             VerticalAlignment="Center"
                                             Fill="{x:Bind local:MainWindow.SpeakerBrush(ColourIndex)}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Label, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource BodyTextBlockStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="NoSpeakers" Grid.Row="1" Margin="16,2,16,0"
                               Text="People appear here as they speak."
                               TextWrapping="Wrap" VerticalAlignment="Top"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                    <!-- Model picker: an inline expander animating its own height.
                         Not a WinUI Expander - that sits in an Auto row above a star-sized
                         speaker list, so the row snapped to its final size while the expander
                         animated its content, which read as a whip. Here one eased animation
                         drives the height, and the star row follows it frame by frame.
                         The list stays in the tree at zero height, so its items are already
                         realised before the section opens. -->
                    <StackPanel Grid.Row="2" Margin="0,2,0,6">
                        <Button x:Name="ModelToggle" Click="OnToggleModelSection"
                                Margin="8,0,8,0" Padding="8,6"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent" BorderThickness="0"
                                AutomationProperties.Name="Speech model">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="0">
                                    <TextBlock Text="Speech model"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="HeaderModelName"
                                               FontSize="11.5" LineHeight="15"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <FontIcon x:Name="ModelChevron" Grid.Column="1"
                                          Glyph="&#xE70D;" FontSize="10"
                                          VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                    <FontIcon.RenderTransform>
                                        <RotateTransform x:Name="ModelChevronRotate" Angle="0" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                            </Grid>
                        </Button>

                        <!-- A ScrollViewer purely because it clips: a Border or Grid with a
                             constrained Height still paints its overflowing children.
                             Horizontal must be Disabled rather than Hidden — Hidden still
                             measures the content at infinite width, so TextTrimming never
                             engages and long names hard-clip at the pane edge instead of
                             ellipsing. Vertical stays Hidden so content can exceed the
                             animated height and simply be clipped. -->
                        <ScrollViewer x:Name="ModelPanel" Height="0"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollMode="Disabled"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ModelOptions" ItemsSource="{x:Bind Models}"
                                          Margin="12,2,18,6"
                                          VerticalAlignment="Top"
                                          AutomationProperties.Name="Speech models">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ModelRow">
                                        <RadioButton GroupName="SpeechModel" Margin="0,1"
                                                     MinWidth="0" MinHeight="0"
                                                     HorizontalAlignment="Stretch"
                                                     HorizontalContentAlignment="Stretch"
                                                     IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                                     IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                                                     Checked="OnModelChecked"
                                                     Tag="{x:Bind Id}"
                                                     ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}"
                                                     AutomationProperties.Name="{x:Bind Name}">
                                            <!-- Name and description on the left; download size
                                                 and glyph on the right, only when the model is
                                                 not on disk. Keeping size out of the description
                                                 line leaves the description readable and makes a
                                                 missing model recognisable without reading. -->
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Spacing="0" Padding="0,1,0,1">
                                                    <!-- Name and the "In use" badge share a
                                                         line. The name takes the remaining
                                                         width and trims; the badge never
                                                         shrinks, so which model is running
                                                         stays legible in a 240px pane. -->
                                                    <Grid ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{x:Bind Name}"
                                                                   FontSize="12.5" LineHeight="16"
                                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="NoWrap" />
                                                        <Border Grid.Column="1" CornerRadius="8"
                                                                Padding="7,1,7,2" VerticalAlignment="Center"
                                                                Visibility="{x:Bind InUseVisibility, Mode=OneWay}"
                                                                Background="{ThemeResource SunnoInkSubtleBrush}">
                                                            <TextBlock Text="In use" FontSize="10"
                                                                       LineHeight="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{ThemeResource SunnoInkBrush}" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{x:Bind SecondaryText, Mode=OneWay}"
                                                               Visibility="{x:Bind SecondaryVisibility, Mode=OneWay}"
                                                               FontSize="11" LineHeight="14"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <ProgressBar Height="2" Margin="0,5,4,5"
                                                                 Visibility="{x:Bind BusyVisibility, Mode=OneWay}"
                                                                 IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                                                 Value="{x:Bind Progress, Mode=OneWay}"
                                                                 Minimum="0" Maximum="100"
                                                                 HorizontalAlignment="Stretch" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                            Spacing="4" VerticalAlignment="Center"
                                                            Visibility="{x:Bind DownloadHintVisibility, Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind SizeLabel}"
                                                               FontSize="11" TextWrapping="NoWrap"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <FontIcon Glyph="&#xE896;" FontSize="11"
                                                              VerticalAlignment="Center"
                                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- transcript -->
            <Grid Grid.Column="1">
                <!-- The element a screen reader actually hears. LiveSetting on the items
                     control announced nothing: it is metadata, and nothing in WinUI raises
                     LiveRegionChanged for it. A dedicated one-line element carries the text
                     instead, so exactly one finalised caption is spoken per utterance rather
                     than every provisional revision.

                     Sized 1x1 with transparent ink rather than Height=0/Opacity=0. A
                     zero-area element reports IsOffscreen=true, and assistive clients skip
                     offscreen providers — verified with a UIA client, which saw the element
                     but received no events from it. One transparent pixel is imperceptible
                     and keeps it a live participant in the tree.

                     Deliberately no AutomationProperties.Name: a TextBlock's UIA name
                     defaults to its text, and naming it would make every announcement read
                     the label instead of the caption. -->
                <TextBlock x:Name="CaptionAnnouncer"
                           Width="1" Height="1" IsHitTestVisible="False"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           Foreground="Transparent"
                           AutomationProperties.LiveSetting="Polite" />
                <!-- Top padding clears the overflow button that floats at this corner, so
                     a caption can never slide underneath it. -->
                <ScrollViewer x:Name="CaptionScroller" VerticalScrollBarVisibility="Auto"
                              Padding="24,40,24,16">
                    <ItemsControl x:Name="CaptionItems" ItemsSource="{x:Bind Lines}"
                                  FontSize="{x:Bind CaptionSize, Mode=OneWay}"
                                  AutomationProperties.Name="Live transcript">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:CaptionLine">
                                <StackPanel Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                Margin="0,0,0,3"
                                                Visibility="{x:Bind local:MainWindow.BoolToVisible(HasSpeaker), Mode=OneWay}">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{x:Bind local:MainWindow.SpeakerBrush(ColourIndex), Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind DisplayLabel, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind TimeLabel, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <!-- clarity: speech-practice feedback, on the user's own lines only -->
                                        <Border Visibility="{x:Bind local:MainWindow.BoolToVisible(ShowClarity), Mode=OneWay}"
                                                CornerRadius="4" Padding="6,0,6,1"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock Text="{x:Bind local:MainWindow.ClarityText(Clarity), Mode=OneWay}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{x:Bind local:MainWindow.ClarityBrush(Clarity), Mode=OneWay}" />
                                        </Border>
                                    </StackPanel>
                                    <!-- RichTextBlock, not TextBlock: inlines aren't UIElements
                                         so they can't carry their own tooltip, and only
                                         RichTextBlock exposes GetPositionFromPoint, which is
                                         what makes per-word confidence on hover possible.
                                         Content is built in code so each word can be styled
                                         and located individually. -->
                                    <RichTextBlock local:WordInlines.Line="{x:Bind}"
                                                   IsTextSelectionEnabled="True"
                                                   TextWrapping="Wrap"
                                                   Opacity="{x:Bind local:MainWindow.LineOpacity(IsFinal, IsSelf), Mode=OneWay}"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   RightTapped="OnTranscriptRightTapped">
                                        <RichTextBlock.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Copy" Click="OnCopyLine">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Copy whole transcript" Click="OnCopyAll">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF0E3;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </RichTextBlock.ContextFlyout>
                                    </RichTextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="EmptyState" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Spacing="6">
                    <!-- The ring and the glyph occupy the same slot: while the engine loads there
                         is nothing to listen with yet, so promising "Listening" would be a lie. -->
                    <Grid Height="60" HorizontalAlignment="Center">
                        <!-- The mark writing itself, rather than a generic spinner. It shows
                             captions being composed, not sound arriving — while the engine
                             loads there is no microphone open, so a "listening" animation
                             would be a lie. Stopping it restores the completed mark. -->
                        <local:SunnoMark x:Name="LoadingRing" Width="58" Height="58"
                                         IsAnimating="True"
                                         AutomationProperties.AccessibilityView="Raw"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <local:SunnoMark x:Name="EmptyGlyph" Width="58" Height="58"
                                         Visibility="Collapsed"
                                         AutomationProperties.AccessibilityView="Raw"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="EmptyTitle" Text="Starting the speech engine"
                               HorizontalAlignment="Center"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="EmptyDetail" Text="This takes about half a minute the first time."
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- command bar -->
        <Border Grid.Row="2" Height="76"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid Padding="16,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <!-- Level sits with the microphone it belongs to, not across the window.
                         A vertical bar reads as "how loud" at a glance and takes almost no
                         width, which matters beside a picker that already wants 190px.
                         Brushes are ones already proven elsewhere in this file - an unresolved
                         ThemeResource key faults at render time, which surfaces as an opaque
                         stowed exception rather than a build or parse error. -->
                    <Grid Width="4" Height="26" VerticalAlignment="Center"
                          AutomationProperties.Name="Microphone input level">
                        <Rectangle RadiusX="2" RadiusY="2"
                                   Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Rectangle x:Name="LevelFill" RadiusX="2" RadiusY="2" Height="0"
                                   VerticalAlignment="Bottom"
                                   Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Grid>
                    <FontIcon Glyph="&#xE720;" FontSize="14"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="DevicePicker" MinWidth="190" MaxWidth="240"
                              PlaceholderText="Default microphone"
                              SelectionChanged="OnDeviceChanged"
                              AutomationProperties.Name="Input device" />
                </StackPanel>

                <Button x:Name="ToggleButton" Grid.Column="1" Click="OnToggleCapture"
                        Width="52" Height="52" CornerRadius="26" Padding="0"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.Name="Pause transcribing"
                        ToolTipService.ToolTip="Pause or resume transcribing (Space)">
                    <!-- Pause bars, not a stop square. The backend has always treated this
                         as a pause — the command handler calls controller.pause(), and the
                         model and ASR worker stay resident across cycles — so resuming costs
                         a fraction of a second, not the half-minute a cold start takes. A
                         stop square promised otherwise, which discourages ducking out of a
                         conversation for an aside. The microphone genuinely is released
                         either way; the status line keeps saying so. -->
                    <FontIcon x:Name="ToggleGlyph" Glyph="&#xE769;" FontSize="17" />
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Spacing="4" VerticalAlignment="Center" MinWidth="160">
                        <TextBlock x:Name="StatusText" Text=""
                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Overflow menu, in the content area just under the caption buttons rather than
             in the title bar itself. That is where Sound Recorder and its siblings put
             window-level commands, and it keeps the drag region intact: SetTitleBar hands
             the whole bar to the window manager, so a button placed inside it silently
             stops receiving clicks. Declared after the body so it draws above it. -->
        <Button x:Name="MoreButton" Grid.Row="1" Width="32" Height="32" Padding="0"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,12,0"
                Background="Transparent" BorderThickness="0"
                AutomationProperties.Name="More options"
                ToolTipService.ToolTip="More options">
            <FontIcon Glyph="&#xE712;" FontSize="15" />
            <Button.Flyout>
                <MenuFlyout Placement="Bottom">
                    <MenuFlyoutItem Text="Larger text" Click="OnBigger">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E8;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Smaller text" Click="OnSmaller">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E7;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <!-- Check on the left, icon beside it: the arrangement File
                         Explorer, Notepad and Task Manager all use, and what the
                         default template already does. An earlier attempt to move
                         the check into the right-hand slot fought the control's
                         visual states and left two ticks on hover; that slot is
                         for accelerators and submenu chevrons, not state. -->
                    <ToggleMenuFlyoutItem x:Name="AlwaysOnTopItem" Text="Always on top"
                                          IsChecked="True" Click="OnToggleAlwaysOnTop">
                        <ToggleMenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE718;" />
                        </ToggleMenuFlyoutItem.Icon>
                    </ToggleMenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Clear transcript" Click="OnClear">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Button.Flyout>
        </Button>

        <!-- Actionable errors, chiefly the microphone-blocked case. The whole reason this
             app is packaged is the per-app microphone toggle, so the state that toggle
             creates must be explained rather than dumped as PortAudio diagnostics. -->
        <InfoBar x:Name="MicInfoBar" Grid.Row="1" Severity="Warning" IsOpen="False"
                 IsClosable="True" VerticalAlignment="Top" Margin="16,8,56,0"
                 CloseButtonClick="OnMicInfoClosed">
            <InfoBar.ActionButton>
                <HyperlinkButton x:Name="MicActionLink" Content="Open Settings"
                                 Click="OnMicAction" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- first run: choose and download a speech model -->
        <Grid x:Name="SetupOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="560" Spacing="6" Padding="32,44,32,32"
                            HorizontalAlignment="Center">

                    <FontIcon Glyph="&#xE896;" FontSize="26" HorizontalAlignment="Left"
                              Margin="0,0,0,10"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Choose a speech model"
                               Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,18"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Sunno runs entirely on your PC — nothing is sent to the internet once this is downloaded. The model is downloaded once and reused." />

                    <ListView x:Name="ModelList" SelectionMode="Single"
                              AutomationProperties.Name="Available speech models">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="12,10" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ModelChoice">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Name}"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <Border Visibility="{x:Bind local:MainWindow.BoolToVisible(Available)}"
                                                    CornerRadius="4" Padding="6,0,6,1"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                <TextBlock Text="Already downloaded"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind DetailWithSpeed}" TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind SizeLabel}"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel x:Name="DownloadPanel" Visibility="Collapsed" Spacing="6"
                                Margin="0,18,0,0">
                        <muxc:ProgressBar x:Name="DownloadBar" Minimum="0" Maximum="100"
                                          AutomationProperties.Name="Download progress" />
                        <TextBlock x:Name="DownloadText" Text=""
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <InfoBar x:Name="SetupError" IsOpen="False" Severity="Error"
                             IsClosable="False" Margin="0,14,0,0" />

                    <Button x:Name="DownloadButton" Content="Download and continue"
                            Click="OnDownloadModel" Margin="0,20,0,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource AccentButtonStyle}" />

                    <TextBlock Margin="0,14,0,0" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="You can change the model later. Larger models are more accurate on accented speech and at a distance from the microphone." />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
