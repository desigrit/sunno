<UserControl
    x:Class="Sunno.Controls.AppUpdatePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="8">
        <TextBlock Text="Updates" Style="{StaticResource BodyStrongTextBlockStyle}"
                   AutomationProperties.HeadingLevel="Level2" />
        <StackPanel Orientation="Horizontal" Spacing="6">
            <Button x:Name="UpdateAction" Content="Check for updates" Click="OnAction" />
            <Button x:Name="CancelAction" Content="Cancel" Visibility="Collapsed" Click="OnCancel"
                    AutomationProperties.Name="Cancel update request" />
            <Button x:Name="UpdateOptions" Width="32" MinHeight="32" Padding="0"
                    AutomationProperties.Name="Update options" ToolTipService.ToolTip="Update options">
                <FontIcon Glyph="&#xE712;" FontSize="14" />
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Check again" Click="OnCheckAgain" />
                        <MenuFlyoutItem Text="View GitHub releases" Click="OnViewReleases" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
        <ProgressBar x:Name="DownloadProgress" Visibility="Collapsed" IsIndeterminate="True"
                     AutomationProperties.Name="Update progress" />
        <TextBlock x:Name="UpdateStatus" Visibility="Collapsed" TextWrapping="Wrap"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>
