<UserControl
    x:Class="Sunno.Controls.LanguageSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sunno.Controls"
    IsTabStop="False">
    <StackPanel>
        <controls:SidebarDisclosure x:Name="Disclosure" x:FieldModifier="internal"
                                    AutomationProperties.Name="Language">
            <controls:SidebarDisclosure.Header>
                <TextBlock Text="Language" Style="{StaticResource SidebarDetailTextStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </controls:SidebarDisclosure.Header>
            <StackPanel x:Name="PickerRows" x:FieldModifier="internal" Margin="8,0,0,0">
                <controls:LanguagePicker x:Name="SpokenPicker" x:FieldModifier="internal" />
                <controls:LanguagePicker x:Name="TranslationPicker" x:FieldModifier="internal" />
            </StackPanel>
        </controls:SidebarDisclosure>
        <TextBlock x:Name="Notice" x:FieldModifier="internal" Visibility="Collapsed"
                   Margin="16,2,16,4" TextWrapping="Wrap"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>
