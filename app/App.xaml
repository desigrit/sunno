<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Sunno.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The single ink the artwork is drawn in: the splash, the mark in the empty
                 state and the first-run screen are all one colour, varied only in strength.
                 Deliberately the brand teal rather than the user's accent colour — this is
                 the same mark as the app icon, and an icon that recolours per machine stops
                 being an identity. Lifted on dark, where #1F8A70 goes muddy against Mica,
                 and handed to the system in high contrast, where any brand colour is wrong. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="SunnoInkBrush" Color="#42B795" />
                    <!-- Badge fill: the same ink at low opacity, so the pill reads as teal
                         while the label stays full-strength teal on top of it. A solid teal
                         fill with white text measures 4.26:1 in light theme — under the 4.5:1
                         a small bold label needs — and this app is the last place to ship a
                         contrast shortfall. -->
                    <SolidColorBrush x:Key="SunnoInkSubtleBrush" Color="#42B795" Opacity="0.22" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SunnoInkBrush" Color="#1F8A70" />
                    <SolidColorBrush x:Key="SunnoInkSubtleBrush" Color="#1F8A70" Opacity="0.16" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="SunnoInkBrush"
                                     Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SunnoInkSubtleBrush"
                                     Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Speaker palette. Everything else uses system theme resources so the app
                 follows light/dark, high contrast and the user accent colour. Mid-tone
                 hues, legible on both light and dark Mica. -->
            <SolidColorBrush x:Key="Speaker0" Color="#2AA198" />
            <SolidColorBrush x:Key="Speaker1" Color="#4C8DDA" />
            <SolidColorBrush x:Key="Speaker2" Color="#D08442" />
            <SolidColorBrush x:Key="Speaker3" Color="#A672D0" />
            <SolidColorBrush x:Key="Speaker4" Color="#D169B5" />
            <SolidColorBrush x:Key="Speaker5" Color="#6FA33C" />
            <SolidColorBrush x:Key="Speaker6" Color="#D9534F" />
            <SolidColorBrush x:Key="Speaker7" Color="#C9A227" />

            <SolidColorBrush x:Key="ClarityGood" Color="#2E8B57" />
            <SolidColorBrush x:Key="ClarityMid" Color="#B26A00" />
            <SolidColorBrush x:Key="ClarityLow" Color="#C42B1C" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
