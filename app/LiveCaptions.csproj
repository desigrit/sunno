<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- 1903 (18362), not 1809: AppCapability.Create - the microphone pre-flight check that
         justifies packaging this as MSIX - is only available from 18362. Advertising 17763
         would claim support on an OS where that check throws. -->
    <TargetPlatformMinVersion>10.0.18362.0</TargetPlatformMinVersion>
    <RootNamespace>LiveCaptions</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged by default for fast iteration (dotnet run / F5). packaging/build-msix.ps1
         passes -p:PackageForMsix=true, which switches to the packaged WinAppSDK mode: the
         app then relies on package identity rather than shipping the bootstrapper. -->
    <WindowsPackageType Condition="'$(PackageForMsix)' == 'true'">MSIX</WindowsPackageType>
    <WindowsPackageType Condition="'$(PackageForMsix)' != 'true'">None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- Packaging is done by build-msix.ps1 with MakeAppx over the published output, not by
         the MSBuild appx targets, so no AppxManifest lives in the project. -->
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260710003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.8249" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tile/logo assets for MSIX, plus the .ico used by the unpackaged exe. -->
    <Content Include="Assets\**\*.png" />
    <Content Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup Condition="'$(PackageForMsix)' == 'true'">
    <!-- Single source of truth for the package manifest. The MSIX build copies this into the
         staging layout as AppxManifest.xml; referencing it here lets MSBuild validate it.
         Conditional because the MSIX targets reject an AppxManifest when
         WindowsPackageType is None, which is the default (unpackaged) build. -->
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

</Project>
